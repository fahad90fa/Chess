{
  "manifest_version": 3,
  "name": "Local Stockfish Analysis (Educational)",
  "short_name": "SF Analysis",
  "version": "1.0.0",
  "description": "Analyze chess positions with a local Stockfish 17.1 engine (WASM, no network). Works on the chess.com analysis board (where engines are allowed) and on a built-in standalone page. Visible overlay, no anti-detection.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Local Stockfish Analysis",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/analysis*",
        "https://www.chess.com/analysis/*"
      ],
      "js": ["chesslib.js", "overlay.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/analysis*",
        "https://www.chess.com/analysis/*"
      ],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
